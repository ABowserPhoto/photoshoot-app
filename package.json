{
  "name": "photoshoot-app",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "worker": "node ./scripts/processing-worker.mjs",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:desktop": "concurrently \"npm run dev\" \"npm run dev:electron\"",
    "prepare:desktop-env": "node scripts/prepare-electron-env.mjs",
    "build:desktop": "node scripts/clean-dist-desktop.mjs && set CSC_IDENTITY_AUTO_DISCOVERY=false && npm run prepare:desktop-env && next build && node scripts/prepare-electron-standalone.mjs && electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "canvas-confetti": "^1.9.4",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "exifreader": "^4.38.1",
    "exiftool-vendored": "^35.20.0",
    "googleapis": "^148.0.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.4",
    "react-player": "^3.4.0",
    "react-rnd": "^10.5.3",
    "react-select": "^5.10.2",
    "react-sketch-canvas": "^6.2.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.studiosuite.workflow",
    "productName": "Studio Workflow Suite",
    "artifactName": "Studio-Workflow-Suite-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.ico",
    "asar": true,
    "extraMetadata": {
      "main": "main.js"
    },
    "beforeBuild": "scripts/electron-before-build.cjs",
    "directories": {
      "app": "electron-shell",
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!AIPhotos{,/**/*}",
      "!ComfyUI{,/**/*}",
      "!models{,/**/*}",
      "!photos{,/**/*}",
      "!*.safetensors",
      "!*.ckpt",
      "!dist-desktop{,/**/*}",
      "!dist-desktop_*{,/**/*}",
      "!dist-desktop-*{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!node_modules",
          "!node_modules/**/*",
          "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
          "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
          "!**/node_modules/*.d.ts",
          "!**/node_modules/.bin",
          "!AIPhotos{,/**/*}",
          "!ComfyUI{,/**/*}",
          "!models{,/**/*}",
          "!photos{,/**/*}",
          "!*.safetensors",
          "!*.ckpt",
          "!dist-desktop{,/**/*}",
          "!dist-desktop_*{,/**/*}",
          "!dist-desktop-*{,/**/*}",
          "!electron-shell{,/**/*}"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts",
        "to": "photoshoot-worker/scripts",
        "filter": [
          "processing-worker.mjs",
          "localFolderName.mjs"
        ]
      },
      {
        "from": "lib",
        "to": "photoshoot-worker/lib",
        "filter": [
          "bracketGrouping.mjs",
          "sanitizeStoragePath.mjs",
          "server/fetchWithTimeout.mjs"
        ]
      },
      {
        "from": "app/api/gallery",
        "to": "photoshoot-worker/app/api/gallery",
        "filter": [
          "previewMagick.mjs"
        ]
      },
      {
        "from": "electron/photoshoot-worker.package.json",
        "to": "photoshoot-worker/package.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
