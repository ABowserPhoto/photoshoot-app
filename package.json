{
  "name": "photoshoot-app",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "worker": "node ./scripts/processing-worker.mjs",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:desktop": "concurrently \"npm run dev\" \"npm run dev:electron\"",
    "build:desktop": "next build && node scripts/prepare-electron-standalone.mjs && electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "canvas-confetti": "^1.9.4",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "exifreader": "^4.38.1",
    "exiftool-vendored": "^35.20.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.4",
    "react-player": "^3.4.0",
    "react-rnd": "^10.5.3",
    "react-select": "^5.10.2",
    "react-sketch-canvas": "^6.2.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.studiosuite.workflow",
    "productName": "Workflow Studio",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
